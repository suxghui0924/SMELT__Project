--- !u!114 &1128825364
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1128825359}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 373ca7e75d9076f4e9eb5e1fd583bea1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  start:
  - "\uC548\uB155? \uB09C \uC774 \uC12C\uC758 \uACF5\uC8FC\uC57C, \uC798\uBD80\uD0C1\uD574!"
  - "\uB10C \uC9C0\uAE08\uBD80\uD130 \uC774 \uC0C1\uC810\uC744 \uC6B4\uC601 \uD558\uAC8C
    \uB420 \uAC70\uC57C"
  - "\uC6B0\uC120 \uBB34\uAE30 \uC81C\uC791\uC5D0 \uD544\uC694\uD55C \uC7AC\uB8CC\uB97C
    \uBAA8\uC544\uBCF4\uC790!"
  - "WASD\uB97C \uB20C\uB7EC\uC11C \uC624\uB978\uCABD\uC5D0 \uC788\uB294 \uBE68\uAC04
    \uCE74\uD3AB\uC73C\uB85C \uC774\uB3D9\uD574 \uBCF4\uC790!"
  enterDungeon1:
  - "E\uD0A4\uB97C \uB20C\uB7EC\uC11C \uC785\uC7A5\uD574\uBCF4\uC790."
  dungeon1:
  - "\uC624\uB978\uCABD \uC544\uB798\uC5D0 \uC788\uB294 \uAC8C\uC774\uC9C0\uB294
    \uAE30\uB825 \uAC8C\uC774\uC9C0\uC57C!"
  - "\uAE30\uB825\uC740 \uC2DC\uAC04\uC5D0 \uB530\uB77C \uC18C\uC9C4\uB418\uAE30\uB3C4
    \uD558\uC9C0\uB9CC \uC801\uACFC \uB2FF\uC544\uB3C4 \uC18C\uC9C4\uB3FC!"
  - "\uAE30\uB825\uC774 \uBAA8\uB450 \uC18C\uC9C4\uB418\uBA74 \uADF8 \uB0A0\uC740
    \uB358\uC804\uC5D0 \uB4E4\uC5B4\uC62C \uC218 \uC5C6\uC73C\uB2C8 \uBA85\uC2EC\uD574!."
  dungeon2:
  - "\uC557! \uC800\uAE30 \uC0AC\uACFC\uC11D \uD55C \uB9C8\uB9AC\uAC00 \uB098\uD0C0\uB0AC\uC5B4!."
  dungeon3:
  - "D  \uD0A4\uB97C \uB20C\uB7EC \uACF5\uACA9\uD574\uBCF4\uC790!."
  dungeon4:
  - "A\uD0A4\uB97C \uB20C\uB7EC \uACF5\uACA9\uD574\uBCF4\uC790!"
  dungeon5:
  - "HOME \uBC84\uD2BC\uC744 \uB204\uB974\uBA74 \uC911\uAC04\uC5D0 \uAC00\uAC8C\uB85C
    \uB3CC\uC544\uAC08 \uC218 \uC788\uC5B4."
  ui1:
  - "\uAC00\uC7A5 \uC0C1\uB2E8\uC5D0 \uC788\uB294 UI\uB294 \uBCF4\uC720 \uC7AC\uD654\uC640
    \uBCF4\uC720 \uC7AC\uB8CC\uB97C \uB73B\uD574."
  - "\uC774\uC81C \uC7AC\uB8CC\uB3C4 \uC788\uC73C\uB2C8 \uBB38\uC73C\uB85C \uAC00\uC11C
    E\uB97C \uB20C\uB7EC \uAC00\uAC8C\uB97C \uC5F4\uACE0 \uC190\uB2D8\uC744 \uB9DE\uC774\uD574\uBD10"
  getOrder1:
  - "\uC557, \uC190\uB2D8\uC774 \uBC29\uBB38\uD588\uC5B4!"
  - "\uC8FC\uBB38 \uAC8C\uC2DC\uD310\uC744 \uBD10\uBCF4\uC790!"
  - "\uC774\uAC74 \uC8FC\uBB38\uC5D0 \uB300\uD55C \uC694\uCCAD\uC774\uC57C ."
  - "\uC774 \uAC8C\uC774\uC9C0\uB294 \uC190\uB2D8\uC758 \uC778\uB0B4\uC2EC\uC744
    \uB73B\uD574!"
  - "\uC778\uB0B4\uC2EC\uC740 \uC2DC\uAC04\uC5D0 \uB530\uB77C \uAE4E\uC774\uACE0,
    \uBC1B\uB294 \uB3C8\uC774 \uB5A8\uC5B4\uC838"
  - "\uADF8\uB9AC\uACE0 \uC778\uB0B4\uC2EC\uC774 \uBAA8\uB450 \uB2EC\uBA74 \uC190\uB2D8\uC774
    \uB5A0\uB098\uBC84\uB9AC\uACE0 \uB3C8\uB3C4 \uAE4E\uC774\uB2C8 \uC870\uC2EC\uD574!"
  - "\uC77C\uB2E8 \uC190\uB2D8\uAED8\uC11C \uC8FC\uBB38 \uC694\uCCAD\uC744 \uD588\uC5B4!"
  - " \uD55C\uBC88 \uC7AC\uB8CC\uB3C4 \uC788\uC73C\uB2C8 \uB9CC\uB4E4\uC5B4 \uBCF4\uC790"
  - "\uBAA8\uB8E8\uAC00 \uC788\uB294 \uACF3\uC73C\uB85C \uC774\uB3D9\uD574\uBCF4\uC790!"
  getOrder2:
  - "E\uD0A4\uB97C \uB20C\uB7EC\uBCF4\uC790"
  makeWeapon1:
  - "\uC0C1\uB2E8\uC740 \uBB34\uAE30\uC758 \uC885\uB958, \uC911\uAC04\uC740 \uC8FC
    \uC7AC\uB8CC, \uD558\uB2E8\uC740 \uBD80 \uC7AC\uB8CC\uC57C."
  - "\uC8FC \uC7AC\uB8CC\uC5D0 \uB530\uB77C \uBB34\uAE30\uC758 \uC774\uB984\uACFC
    \uC678\uD615\uC774 \uBC14\uB00C\uC5B4."
  - "\uC0AC\uACFC\uC11D \uAC80\uC744 \uB9CC\uB4E4\uC5B4 \uB2EC\uB77C\uACE0 \uD588\uACE0
    \uBA5C\uB860\uC11D\uB3C4 \uC11E\uC5B4\uB2EC\uB77C\uACE0 \uD588\uC73C\uB2C8 \uB9CC\uB4E4\uC5B4
    \uBCF4\uC790."
  sellWeapon1:
  - "\uBB34\uAE30\uB97C \uB9CC\uB4E4\uC5C8\uC73C\uB2C8 \uC190\uB2D8\uAED8 \uC774\uB3D9\uD574
    \uD314\uC544\uBCF4\uC790!"
  sellWeapon2:
  - "\uB4DC\uB514\uC5B4 \uCCAB\uD310\uB9E4\uAD6C\uB098!"
  - "\uC774\uC81C \uC5C5\uADF8\uB808\uC774\uB4DC\uB97C \uD574\uBCFC\uAE4C?"
  - "\uBE5B\uB098\uB294 \uACF3\uC73C\uB85C \uC774\uB3D9\uD574\uBCF4\uC790!"
  store2:
  - "E\uD0A4\uB97C \uB204\uB974\uC790"
  store3:
  - "\uC5EC\uAE30\uC120 \uC5C5\uADF8\uB808\uC774\uB4DC\uB97C \uD560 \uC218 \uC788\uC5B4"
  - "\uC67C\uCABD \uBC84\uD2BC\uC73C\uB85C \uACE1\uAD2D\uC774\uC640 \uC2A4\uD0AC
    \uD2B8\uB9AC \uC5C5\uADF8\uB808\uC774\uB4DC\uB97C \uC654\uB2E4\uAC14\uB2E4 \uD560
    \uC218 \uC788\uC5B4"
  - "\uBC84\uD2BC\uC744 \uB20C\uB7EC \uB098\uAC00\uC790."
  - "\uC7AC\uB8CC\uAC00 \uBAA8\uC774\uBA74 \uC5EC\uAE30\uC11C \uACE1\uAD2D\uC774\uB97C
    \uC5C5\uADF8\uB808\uC774\uB4DC \uD560 \uC218 \uC788\uC5B4!"
  - "\uC774\uC81C \uCC3D\uC744 \uB2EB\uACE0 \uB2E4\uB978 \uAC70\uC5D0 \uB300\uD574
    \uC54C\uB824\uC904\uAC8C"
  store4:
  - "\uC6B0\uCE21 \uD558\uB2E8\uC5D0 \uBB54\uAC00 \uBCF4\uC774\uC9C0?"
  - "\uC774\uAC74 \uC6B0\uB9AC\uAC00 \uD558\uB8E8 \uB3D9\uC548 \uCC44\uC6CC\uC57C\uD560
    \uD560\uB2F9\uB7C9\uACFC \uC77C\uCC28\uC57C"
  - "\uADF8\uB9AC\uACE0 7\uC77C\uCC28\uAE4C\uC9C0 \uB05D\uB0B4\uAC8C \uB418\uBA74
    \uBCF4\uC2A4\uC5D0 \uB3C4\uC804\uD560 \uC218 \uC788\uC5B4!"
  - "\uCC44\uC6B0\uC9C0 \uBABB\uD558\uBA74 \uD3D0\uC5C5\uD558\uAC8C \uB418\uB2C8
    \uC870\uC2EC\uD574"
  changeBgm2:
  - "\uB77C\uB514\uC624\uB294 E\uD0A4\uB97C \uB204\uB974\uACE0 \uCC3D\uC744 \uC5F4\uC5B4
    \uB178\uB798\uB97C \uBC14\uAFC0 \uC218 \uC788\uC5B4."
  nextDay2:
  - "\uCE98\uB9B0\uB354\uB294 E\uD0A4\uB97C \uB204\uB974\uACE0 \uCC3D\uC744 \uC5F4\uBA74
    \uD560\uB2F9\uB7C9 \uC81C\uCD9C\uD560 \uB9CC\uD07C\uC758 \uB3C8\uC774 \uC788\uB2E4\uBA74
    \uB2E4\uC74C \uB0A0\uC9DC\uB85C \uAC08 \uC218 \uC788\uC5B4."
  last:
  - "\uC774\uC81C \uB0B4\uAC00 \uC54C\uB824\uC904 \uAC74 \uB2E4 \uC54C\uB824\uC900
    \uAC70 \uAC19\uB124 \uD654\uC774\uD305\uD574\uBD10~!"
